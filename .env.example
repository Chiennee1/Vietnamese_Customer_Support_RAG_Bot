APP_ENV=development
APP_SECRET=replace-with-a-random-value
JWT_SECRET=replace-with-a-random-value
DATABASE_URL=postgresql+asyncpg://app:local-password@db:5432/support_rag
POSTGRES_DB=support_rag
POSTGRES_USER=app
POSTGRES_PASSWORD=local-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_MAX_OUTPUT_TOKENS=700
MAX_TOOL_CALLS=8
TOOL_TIMEOUT_SECONDS=8
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RERANKER_PROVIDER=none
RERANKER_MODEL=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=80
RAG_CANDIDATE_K=20
RAG_FINAL_K=6
RAG_MINIMUM_SCORE=0.015
RRF_RANK_CONSTANT=60
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_PER_WINDOW=10
RATE_LIMIT_CHAT_PER_WINDOW=30
RATE_LIMIT_UPLOAD_PER_WINDOW=20
RATE_LIMIT_GENERAL_PER_WINDOW=120
CONVERSATION_RETENTION_DAYS=30
RETENTION_INTERVAL_SECONDS=86400
VITE_API_BASE_URL=http://localhost:8000/api/v1
